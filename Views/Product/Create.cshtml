<h1>Ajouter un produit</h1>

<form>

    <div class="mb-3">
        <label class="form-label">
            Nom du produit
        </label>

        <input type="text"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">
            Prix
        </label>

        <input type="number"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">
            Stock
        </label>

        <input type="number"
               class="form-control" />
    </div>

    <button type="submit"
            class="btn btn-success">
        Enregistrer
    </button>

</form>