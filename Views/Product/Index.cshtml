@model IEnumerable<GestionProduitsMVC.Models.Product>

<h1>Liste des produits</h1>

<a href="/Product/Create" class="btn btn-primary">
    Ajouter un produit
</a>

<table class="table table-bordered mt-3">
    <thead>
        <tr>
            <th>Nom</th>
            <th>Prix</th>
            <th>Stock</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.Price.ToString("#,##0") FCFA</td>
                <td>@product.Stock</td>

                <td>
                    <a href="/Product/Details/@product.Id" class="btn btn-info">
                        Détail
                    </a>

                    <a href="#" class="btn btn-warning">
                        Modifier
                    </a>

                    <a href="#" class="btn btn-danger">
                        Supprimer
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>