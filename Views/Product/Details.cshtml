@model GestionProduitsMVC.Models.Product

<h1>Détail du produit</h1>

<div class="card p-3">

    <h3>@Model.Name</h3>

    <p>
        <strong>Prix :</strong>
        @Model.Price.ToString("#,##0") FCFA
    </p>

    <p>
        <strong>Stock :</strong>
        @Model.Stock
    </p>

    <p>
        <strong>Description :</strong>
        Ceci est la description du produit @Model.Name.
    </p>

</div>

<a href="/Product/Index" class="btn btn-secondary mt-3">
    Retour
</a>