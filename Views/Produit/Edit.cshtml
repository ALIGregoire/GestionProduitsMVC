@model GestionProduitsMVC.Models.Produit

@{
    ViewData["Title"] = "Modifier le produit";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-warning">
                <h4 class="mb-0"><i class="fas fa-edit"></i> @ViewData["Title"]</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="DateCreation" />

                    <div class="mb-3">
                        <label asp-for="Libelle" class="form-label">Libellé du produit *</label>
                        <input asp-for="Libelle" class="form-control" />
                        <span asp-validation-for="Libelle" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="PrixUnitaire" class="form-label">Prix unitaire (€) *</label>
                                <input asp-for="PrixUnitaire" class="form-control" type="number" step="0.01" />
                                <span asp-validation-for="PrixUnitaire" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="StockDisponible" class="form-label">Stock disponible *</label>
                                <input asp-for="StockDisponible" class="form-control" type="number" />
                                <span asp-validation-for="StockDisponible" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="CategorieId" class="form-label">Catégorie *</label>
                                <select asp-for="CategorieId" class="form-select" asp-items="ViewBag.Categories">
                                    <option value="">-- Sélectionner une catégorie --</option>
                                </select>
                                <span asp-validation-for="CategorieId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="FournisseurId" class="form-label">Fournisseur *</label>
                                <select asp-for="FournisseurId" class="form-select" asp-items="ViewBag.Fournisseurs">
                                    <option value="">-- Sélectionner un fournisseur --</option>
                                </select>
                                <span asp-validation-for="FournisseurId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Annuler
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Enregistrer
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}