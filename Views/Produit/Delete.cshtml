@model GestionProduitsMVC.Models.Produit

@{
    ViewData["Title"] = "Supprimer le produit";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="fas fa-exclamation-triangle"></i> @ViewData["Title"]</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <i class="fas fa-info-circle"></i> Êtes-vous sûr de vouloir archiver ce produit ?
                </div>

                <div class="border rounded p-3 mb-3">
                    <div class="row mb-2">
                        <div class="col-md-4 fw-bold">Nom :</div>
                        <div class="col-md-8">@Model.Libelle</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-4 fw-bold">Prix :</div>
                        <div class="col-md-8">@Model.PrixUnitaire.ToString("C")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-4 fw-bold">Stock :</div>
                        <div class="col-md-8">@Model.StockDisponible unités</div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 fw-bold">Catégorie :</div>
                        <div class="col-md-8">@Model.Categorie?.Nom</div>
                    </div>
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Annuler
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-archive"></i> Archiver le produit
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>