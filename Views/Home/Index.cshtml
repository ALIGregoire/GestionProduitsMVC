@{
    ViewData["Title"] = "Tableau de bord";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="bg-primary text-white rounded p-4">
            <h1><i class="fas fa-chart-line"></i> Bienvenue sur Gestion Stock Informatique</h1>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-3 mb-3">
        <div class="card text-center bg-info text-white">
            <div class="card-body">
                <i class="fas fa-box fa-3x mb-2"></i>
                <h3>@ViewBag.TotalProduits</h3>
                <p>Produits en stock</p>
            </div>
        </div>
    </div>
    
    <div class="col-md-3 mb-3">
        <div class="card text-center bg-warning text-white">
            <div class="card-body">
                <i class="fas fa-truck fa-3x mb-2"></i>
                <h3>@ViewBag.TotalFournisseurs</h3>
                <p>Fournisseurs</p>
            </div>
        </div>
    </div>
    
</div>

